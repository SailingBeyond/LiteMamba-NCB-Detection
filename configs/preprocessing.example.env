#!/usr/bin/env bash
# Copy this file to configs/preprocessing.env and edit the values for one dataset.
# This file is sourced by the Bash scripts, so keep standard Bash assignment syntax.

# =============================================================================
# Dataset paths
# =============================================================================
DATASET_NAME="example_dataset"
WORK_DIR="/path/to/example_dataset"

# Input multi-read FAST5 directory and reference FASTA.
MULTI_FAST5_DIR="${WORK_DIR}/fast5"
REFERENCE_FASTA="${WORK_DIR}/reference/refdb_X_to_T.fasta"

# Derived directories and files.
SINGLE_FAST5_DIR="${WORK_DIR}/fast5_single"
BASECALL_DIR="${WORK_DIR}/fast5_single_guppy"
PASS_FASTQ="${BASECALL_DIR}/fast5_single_guppy_pass.fastq"
SEQUENCING_SUMMARY="${BASECALL_DIR}/sequencing_summary.txt"
SORTED_BAM="${BASECALL_DIR}/fast5_single_guppy_pass_sorted.bam"
FILTERED_BAM="${BASECALL_DIR}/filtered_fast5_single_guppy_pass_sorted.bam"
BATCH_OUTPUT_DIR="${BASECALL_DIR}/signal_feature_batches"
FINAL_OUTPUT_DIR="${BASECALL_DIR}/merged_outputs"

# =============================================================================
# Executables
# =============================================================================
PYTHON_BIN="python3"
MULTI_TO_SINGLE_BIN="multi_to_single_fast5"
GUPPY_BIN="/opt/ont/guppy/bin/guppy_basecaller"
TOMBO_BIN="tombo"
MINIMAP2_BIN="minimap2"
SAMTOOLS_BIN="samtools"

# =============================================================================
# Basecalling
# =============================================================================
MULTI_TO_SINGLE_THREADS=40
GUPPY_CONFIG="dna_r9.4.1_450bps_hac.cfg"
GUPPY_DEVICE="cuda:all"
GUPPY_NUM_CALLERS=40
# Additional Guppy arguments, for example: "--compress_fastq".
GUPPY_EXTRA_ARGS=""

# Set to 1 only when intentionally reusing non-empty output directories.
ALLOW_EXISTING_OUTPUTS=0

# =============================================================================
# Tombo annotation and resquiggle
# =============================================================================
TOMBO_ANNOTATE_PROCESSES=16
TOMBO_RESQUIGGLE_PROCESSES=10
TOMBO_CORRECTED_GROUP="RawGenomeCorrected_000"
TOMBO_BASECALL_GROUP="Basecall_1D_000"
TOMBO_EVENT_SUBGROUP="BaseCalled_template"
TOMBO_NUM_MOST_COMMON_ERRORS=5
TOMBO_FIT_GLOBAL_SCALE=1
TOMBO_INCLUDE_EVENT_STDEV=1

# =============================================================================
# Alignment and BAM filtering
# =============================================================================
MINIMAP2_THREADS=40
MINIMAP2_PRESET="map-ont"
MINIMAP2_WINDOW=5
MINIMAP2_SECONDARY="no"
SAMTOOLS_THREADS=56
# 3844 = unmapped + secondary + QC-fail + duplicate + supplementary.
SAMTOOLS_FILTER_FLAGS=3844

# =============================================================================
# FAST5 signal extraction
# =============================================================================
SIGNAL_PROCESSES=40
SIGNAL_BAM_THREADS=16
SIGNAL_FAST5_CHUNKSIZE=64
SIGNAL_MAX_LEN_GAP=10
SIGNAL_REQUIRE_STRAND_MATCH=0
SIGNAL_REQUIRE_SEQ_MATCH=0
SIGNAL_ALWAYS_TAKE_INTERSECTION=0
SIGNAL_KEEP_CACHE=0

# Numeric immediate subfolders produced by multi_to_single_fast5.
# Use "auto" to discover the minimum and maximum numeric folder names.
FOLDER_START="auto"
FOLDER_END="auto"
FOLDER_BATCH_SIZE=500

# =============================================================================
# Strand-aware 6-mer feature extraction
# =============================================================================
TARGET_POS=1275
MIN_LEFT_POS=1258
MASK_BASE="N"
LABEL_X=4
LABEL_Y=5
DWELL_SCALE=1.0
QUALITY_SCALE=1.0
MAD_USE_UNIQUE=1
FEATURE_REQUIRE_STRAND_MATCH=1
SIGNAL_ROUND=6
STAT_ROUND=6

# =============================================================================
# Batch execution and merging
# =============================================================================
# Resume completed feature batches when set to 1.
RESUME_BATCHES=1
# Merging all signal TSVs can require substantial additional disk space.
MERGE_SIGNAL_TABLES=0
# Merge diagnostic mismatch tables when set to 1.
MERGE_MISMATCH_TABLES=1

# Set to 1 to print commands without running external programs.
DRY_RUN=0
